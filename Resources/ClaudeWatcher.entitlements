<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (release builds): allow sending Apple Events to Ghostty and
	     Terminal.app. Not sandboxed. Dev builds (no hardened runtime) don't need it. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
